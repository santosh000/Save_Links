{
	// Save_Links production deployment — Cloudflare Worker serving the built SPA
	// from dist/ plus the /auth/* and /api/* boundaries (see run_worker_first).
	//
	// Assets-first routing: requests that match a file in dist/ (Vue/PWA shell,
	// hashed assets, /sw.js, manifest, icons) are served directly by the
	// static-assets layer WITHOUT invoking the Worker script — free and
	// unlimited on the Free tier per
	// https://developers.cloudflare.com/workers/static-assets/billing-and-limitations/.
	// Non-asset navigation requests get the SPA fallback below. The Worker
	// script (worker/index.js) runs only for the /auth/* and /api/* patterns
	// listed in run_worker_first and for requests that match no asset.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "save-links",
	"main": "./worker/index.js",
	// Today's date. >2025-04-01 also enables assets_navigation_prefers_asset_serving
	// (navigation requests never invoke the Worker script).
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Official SPA fallback: any request that matches no asset is served
		// index.html (200), while real files (/sw.js, manifest, /assets/*) are
		// never shadowed. https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/
		"not_found_handling": "single-page-application",
		// The compatibility_date above enables
		// assets_navigation_prefers_asset_serving — navigation requests normally
		// NEVER invoke the Worker script, so /auth/* would be swallowed by the
		// SPA fallback. This glob routes /auth/* and /api/* to the Worker first;
		// all other navigation/asset paths keep assets-first Phase 3A behavior.
		//
		// Phase A (auth integration): the frontend restores its session via
		// GET /api/me (and rotates via POST /api/session/refresh). Those API GETs
		// are non-asset requests that would otherwise be served the SPA index.html
		// by the assets fallback instead of reaching the Worker script. Routing
		// /api/* to the Worker first fixes that: known routes are handled by the
		// Worker (which never serves index.html for /api/*), and unknowns already
		// return a proper 404 via the script — never the SPA shell.
		// https://developers.cloudflare.com/workers/static-assets/binding/#run_worker_first
		"run_worker_first": [
			"/auth/*",
			"/api/*"
		]
	},
	// Application accounts + server-side sessions + sync state
	// (worker/db/store.js). Local development / local migrations use only
	// database_name (the local Miniflare D1); database_id below is the
	// PRODUCTION D1 database (save-links-db), already deployed and migrated
	// (see MAINTAINERS.md).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "save-links-db",
			"database_id": "39997a61-6efe-4628-9054-1c61c173f83f"
		}
	],
	// OAuth sign-in (worker/oauth/*): Google is the primary provider, GitHub
	// also supported; the Google callback additionally verifies Google's
	// signed id_token server-side. All secrets are deployed as Wrangler
	// secrets (`wrangler secret put <NAME>`) for production and read from the
	// gitignored .dev.vars file locally (see MAINTAINERS.md; {env}.dev.vars
	// matching is supported). `required` is a deploy guard: a `wrangler deploy`
	// fails loudly instead of shipping half-configured auth.
	// https://developers.cloudflare.com/workers/wrangler/configuration/#secrets
	"secrets": {
		"required": [
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"STATE_HMAC_SECRET"
		]
	},
	// Redirect-origin allowlist (worker/auth.js
	// resolveApprovedOrigin). Comma-separated origins; every /auth/* redirect
	// destination derives only from this list — never from request headers.
	// Non-secret configuration, so it ships as plaintext `vars`, NOT a secret
	// (https://developers.cloudflare.com/workers/configuration/environment-variables/).
	// `vars` is non-inheritable: each `env.<name>.vars` must set its own, and
	// the empty default here deliberately FAILS CLOSED — unconfigured
	// deployments return 503 and start no OAuth flow. Local development sets it
	// in .dev.vars (gitignored); deployed environments use their env block.
	"vars": {
		"APPROVED_ORIGINS": "https://save-links.ucancallmesan.workers.dev"
	}
}