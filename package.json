  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.1"
  }
}
